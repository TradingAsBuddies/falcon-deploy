[Unit]
Description=Falcon Stock Screener (%i run)
Documentation=https://github.com/TradingAsBuddies/falcon-screener
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ falcon_user }}
Group={{ falcon_group }}
WorkingDirectory={{ falcon_data_dir }}

# Load environment
EnvironmentFile={{ falcon_config_dir }}/secrets.env
Environment="PYTHONUNBUFFERED=1"
Environment="FALCON_ENV={{ falcon_env }}"

# Run the screener with specified run type
ExecStart={{ falcon_venv_path }}/bin/falcon-screener --run-type %i

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-screener-%i

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{ falcon_data_dir }} {{ falcon_cache_dir }}

# Resource limits
{% if screener_memory_max is defined %}
MemoryMax={{ screener_memory_max }}
{% endif %}
{% if screener_cpu_quota is defined %}
CPUQuota={{ screener_cpu_quota }}
{% endif %}

[Install]
WantedBy=multi-user.target
