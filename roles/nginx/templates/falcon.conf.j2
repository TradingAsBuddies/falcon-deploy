# Falcon Trading Platform - Nginx Reverse Proxy Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY

upstream falcon_dashboard {
    server {{ flask_host }}:{{ flask_port }};
    keepalive {{ nginx_upstream_keepalive }};
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name {{ nginx_server_names | join(' ') }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;

    server_name {{ nginx_server_names | join(' ') }};

    # SSL Configuration
    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Logging
    access_log /var/log/nginx/falcon_access.log;
    error_log /var/log/nginx/falcon_error.log;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Dashboard web UI
    location / {
        proxy_pass http://falcon_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (if needed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout {{ nginx_proxy_connect_timeout }}s;
        proxy_send_timeout {{ nginx_proxy_send_timeout }}s;
        proxy_read_timeout {{ nginx_proxy_read_timeout }}s;
    }

    # API endpoints
    location /api/ {
        proxy_pass http://falcon_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Longer timeout for API calls
        proxy_connect_timeout {{ nginx_api_timeout }}s;
        proxy_send_timeout {{ nginx_api_timeout }}s;
        proxy_read_timeout {{ nginx_api_timeout }}s;

        # CORS headers (if accessing from different domain)
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
    }

    # Health check endpoint
    location /health {
        proxy_pass http://falcon_dashboard/health;
        proxy_http_version 1.1;
        access_log off;
    }

    # Static files (if served separately)
    location /static/ {
        alias {{ static_files_dir }}/;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }
}
