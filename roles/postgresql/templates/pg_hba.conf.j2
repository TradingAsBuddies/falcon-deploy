# Falcon Trading Platform - PostgreSQL Client Authentication
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# TYPE  DATABASE        USER            ADDRESS                 METHOD

# Local connections
local   all             postgres                                peer
local   all             all                                     peer

# IPv4 local connections
host    all             all             127.0.0.1/32            scram-sha-256

# IPv6 local connections
host    all             all             ::1/128                 scram-sha-256

# Falcon Trading Platform - Allow local network
# Compute node (falcon-compute)
host    {{ db_name }}   {{ db_user }}   192.168.1.232/32        scram-sha-256

# Web node (falcon-web)
host    {{ db_name }}   {{ db_user }}   192.168.1.162/32        scram-sha-256

# Allow entire local subnet (fallback)
host    {{ db_name }}   {{ db_user }}   192.168.1.0/24          scram-sha-256
