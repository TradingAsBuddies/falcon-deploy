# Falcon Trading Platform - Secrets Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY
# Node: {{ inventory_hostname }} ({{ node_type }})

# Database connection
DB_TYPE={{ db_type }}
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ vault_db_password | default('') }}

{% if node_type == 'compute' %}
# API Keys (compute node)
FINVIZ_AUTH_KEY={{ vault_finviz_auth_key | default('') }}
MASSIVE_API_KEY={{ vault_massive_api_key | default('') }}
MASSIVE_ACCESS_KEY_ID={{ vault_massive_access_key_id | default('') }}
MASSIVE_SECRET_ACCESS_KEY={{ vault_massive_secret_access_key | default('') }}
MASSIVE_ENDPOINT={{ vault_massive_endpoint | default('') }}
MASSIVE_BUCKET={{ vault_massive_bucket | default('') }}
CLAUDE_API_KEY={{ vault_claude_api_key | default('') }}

# Paths
MARKET_DATA_DIR={{ market_data_dir | default(falcon_data_dir + '/market_data') }}
CACHE_DIR={{ falcon_cache_dir }}

# Screener settings
FINVIZ_SCREENER_URL={{ vault_finviz_screener_url | default('') }}
MANUAL_WATCHLIST={{ vault_manual_watchlist | default('') }}
{% endif %}

{% if node_type == 'web' %}
# API Keys (web node)
CLAUDE_API_KEY={{ vault_claude_api_key | default('') }}

# Flask settings
FLASK_HOST={{ flask_host }}
FLASK_PORT={{ flask_port }}
{% endif %}

# Environment
FALCON_ENV={{ falcon_env }}
