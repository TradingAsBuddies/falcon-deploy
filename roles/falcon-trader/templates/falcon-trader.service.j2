[Unit]
Description=Falcon Trading Bot - Multi-Strategy Orchestrator
Documentation=https://github.com/TradingAsBuddies/falcon-trader
After=network-online.target falcon-screener@morning.service
Wants=network-online.target

[Service]
Type=simple
User={{ falcon_user }}
Group={{ falcon_group }}
WorkingDirectory={{ falcon_data_dir }}

# Load environment
EnvironmentFile={{ falcon_config_dir }}/secrets.env
Environment="PYTHONUNBUFFERED=1"
Environment="FALCON_ENV={{ falcon_env }}"

# Run the trader (pip-installed package)
ExecStart={{ falcon_venv_path }}/bin/falcon-trader

# Restart policy
Restart=always
RestartSec={{ systemd_restart_sec }}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-trader

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ falcon_data_dir }} {{ falcon_cache_dir }}

# Resource limits
{% if trader_memory_max is defined %}
MemoryMax={{ trader_memory_max }}
{% endif %}
{% if trader_cpu_quota is defined %}
CPUQuota={{ trader_cpu_quota }}
{% endif %}

[Install]
WantedBy=multi-user.target
