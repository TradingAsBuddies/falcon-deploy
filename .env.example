# Falcon — Podman Desktop local environment
# Copy to .env and fill in your values

# Database
DB_PASSWORD=changeme

# Finviz API (required for screener)
FINVIZ_API_KEY=

# Messenger — Discord
FALCON_DISCORD_WEBHOOK_URL=

# Messenger — Bluesky
FALCON_BLUESKY_HANDLE=
FALCON_BLUESKY_APP_PASSWORD=

# Messenger — poll interval (seconds)
FALCON_POLL_INTERVAL=300

# Traefik — Podman socket path (run: echo /run/user/$(id -u)/podman/podman.sock)
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
