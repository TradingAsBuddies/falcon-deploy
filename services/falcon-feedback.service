[Unit]
Description=Falcon Feedback Loop - Daily Backtest Analysis
Documentation=https://github.com/TradingAsBuddies/falcon-core
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=falcon
Group=falcon
WorkingDirectory=/var/lib/falcon

# Load environment
EnvironmentFile=/etc/falcon/secrets.env
Environment="PYTHONUNBUFFERED=1"
Environment="FALCON_ENV=production"

# Run the feedback loop for previous trading day
ExecStart=/opt/falcon/venv/bin/python -m falcon_core.backtesting.scheduler --run-now

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-feedback

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/falcon /var/cache/falcon

# Resource limits
MemoryMax=2G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
